{
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2023",
		"checkJs": false,
		"lib": ["ES2023", "DOM", "DOM.Iterable"]
	},
	"include": [
		"electron/**/*.js",
		"lib/**/*.js",
		"public/js/**/*.js",
		"server.js",
		"tools/**/*.mjs",
		"eslint.config.js"
	],
	"exclude": ["node_modules", "dist", "data", "theme", "public/res"]
}
